!pipeline/data/triage_log.json
# Rapports du chantier NetFlow : petits fichiers JSON qui constituent
# la trace vérifiable des mesures citées dans docs/. Versionnés
# volontairement ; les modèles et le CSV du jeu (620 Mo) ne le sont pas.
!pipeline/data/netflow/
pipeline/data/netflow/*
!pipeline/data/netflow/netflow_training_report.json
!pipeline/data/netflow/netflow_transfer_report.json
!pipeline/data/netflow/netflow_transfer_diagnostics.json
!pipeline/data/netflow/manifest-sha1.txt
.env
# Toute variante de .env : la règle « .env » seule ne matche que le nom
# exact, or une sauvegarde type .env.bak-20260906 contient les mêmes
# secrets et n'était PAS ignorée (vérifié avec git check-ignore).
.env.*
!.env.example
*.key
*.pem
certs/
venv/
__pycache__/
*.pyc
